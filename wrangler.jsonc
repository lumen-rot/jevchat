{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jev-chat",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "routes": [
    {
      "pattern": "jevchat.lumenrot.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
